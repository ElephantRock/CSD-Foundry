{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csd-foundry:validation-policy:1",
  "title": "Validation Policy",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "decisionClass": {
      "type": "string",
      "enum": [
        "D0",
        "D1",
        "D2",
        "D3",
        "BENCHMARK"
      ]
    },
    "registryType": {
      "type": "string",
      "enum": [
        "EVIDENCE_UNIT",
        "ASSUMPTION",
        "ALTERNATIVE_MODEL"
      ]
    },
    "projectionPhase": {
      "type": "string",
      "enum": [
        "SEMANTIC",
        "EVIDENCE_REGISTRY",
        "ASSUMPTION_REGISTRY",
        "ALTERNATIVE_MODEL_REGISTRY",
        "DISPOSITION",
        "QUARANTINE_COMMIT"
      ]
    },
    "dispositionAction": {
      "type": "string",
      "enum": [
        "DOCUMENT_AND_PROCEED",
        "FLAG_AND_PROCEED",
        "ESCALATE_AND_HOLD",
        "BLOCK",
        "EXCLUDE_FROM_RELEASE"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "validation-policy/1"
    },
    "policy_id": {
      "$ref": "#/$defs/token"
    },
    "policy_version": {
      "$ref": "#/$defs/positiveInteger"
    },
    "canonicalization_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "accepted_raw_event_schemas": {
      "type": "array",
      "minItems": 1,
      "x-csd-collection-kind": "SET",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "allowed_signature_algorithms": {
      "type": "array",
      "minItems": 1,
      "x-csd-collection-kind": "SET",
      "items": {
        "type": "string",
        "enum": [
          "ed25519",
          "ecdsa-p256-sha256",
          "rsa-pss-sha256"
        ]
      }
    },
    "minimum_signature_count": {
      "$ref": "#/$defs/positiveInteger"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "canonicalization_policy_digest",
    "authority_policy_digest",
    "accepted_raw_event_schemas",
    "allowed_signature_algorithms",
    "minimum_signature_count",
    "policy_digest"
  ]
}
