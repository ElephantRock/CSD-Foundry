{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csd-foundry:event-validation-failure:1",
  "title": "Event Validation Failure Receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"},
    "nonNegativeInteger": {"type": "integer","minimum": 0},
    "positiveInteger": {"type": "integer","minimum": 1},
    "token": {"type": "string","pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "decisionClass": {"type": "string","enum": ["D0","D1","D2","D3","BENCHMARK"]},
    "registryType": {"type": "string","enum": ["EVIDENCE_UNIT","ASSUMPTION","ALTERNATIVE_MODEL"]},
    "projectionPhase": {"type": "string","enum": ["SEMANTIC","EVIDENCE_REGISTRY","ASSUMPTION_REGISTRY","ALTERNATIVE_MODEL_REGISTRY","DISPOSITION","QUARANTINE_COMMIT"]},
    "dispositionAction": {"type": "string","enum": ["DOCUMENT_AND_PROCEED","FLAG_AND_PROCEED","ESCALATE_AND_HOLD","BLOCK","EXCLUDE_FROM_RELEASE"]}
  },
  "properties": {
    "schema_version": {"const": "event-validation-failure/1"},
    "raw_event_digest": {"$ref": "#/$defs/digest"},
    "validation_policy_digest": {"$ref": "#/$defs/digest"},
    "signature_set_digest": {"$ref": "#/$defs/digest"},
    "validated_at_tick": {"$ref": "#/$defs/nonNegativeInteger"},
    "failure_codes": {
      "type": "array",
      "minItems": 1,
      "x-csd-collection-kind": "SET",
      "items": {"type": "string","enum": ["RAW_SCHEMA_REJECTED","RAW_DIGEST_MISMATCH","SIGNATURE_DIGEST_MISMATCH","SIGNATURE_ALGORITHM_NOT_ALLOWED","SIGNATURE_INVALID","SIGNATURE_THRESHOLD_NOT_MET","AUTHORITY_SCOPE_REJECTED","VALIDATION_POLICY_NOT_ALLOWED","VALIDATION_CONTEXT_UNAVAILABLE","VALIDATION_CONTEXT_NOT_COMMITTED"]}
    },
    "failure_receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version","raw_event_digest","validation_policy_digest","signature_set_digest","validated_at_tick","failure_codes","failure_receipt_digest"]
}
