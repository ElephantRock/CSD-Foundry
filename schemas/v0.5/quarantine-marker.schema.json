{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csd-foundry:quarantine-marker:1",
  "title": "Quarantine Marker",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string","pattern": "^sha256:[0-9a-f]{64}$"},
    "nonNegativeInteger": {"type": "integer","minimum": 0},
    "positiveInteger": {"type": "integer","minimum": 1},
    "token": {"type": "string","pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "decisionClass": {"type": "string","enum": ["D0","D1","D2","D3","BENCHMARK"]},
    "registryType": {"type": "string","enum": ["EVIDENCE_UNIT","ASSUMPTION","ALTERNATIVE_MODEL"]},
    "projectionPhase": {"type": "string","enum": ["SEMANTIC","EVIDENCE_REGISTRY","ASSUMPTION_REGISTRY","ALTERNATIVE_MODEL_REGISTRY","DISPOSITION","QUARANTINE_COMMIT"]},
    "dispositionAction": {"type": "string","enum": ["DOCUMENT_AND_PROCEED","FLAG_AND_PROCEED","ESCALATE_AND_HOLD","BLOCK","EXCLUDE_FROM_RELEASE"]}
  },
  "properties": {
    "schema_version": {"const": "quarantine-marker/1"},
    "quarantine_epoch": {"$ref": "#/$defs/positiveInteger"},
    "invalidation_event_digest": {"$ref": "#/$defs/digest"},
    "affected_asset_index_digest": {"$ref": "#/$defs/digest"},
    "committed_clock_sequence": {"$ref": "#/$defs/positiveInteger"},
    "quarantine_policy_digest": {"$ref": "#/$defs/digest"},
    "quarantine_marker_digest": {"$ref": "#/$defs/digest"}
  },
  "required": ["schema_version","quarantine_epoch","invalidation_event_digest","affected_asset_index_digest","committed_clock_sequence","quarantine_policy_digest","quarantine_marker_digest"]
}
