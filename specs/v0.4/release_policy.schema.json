{
  "$id": "https://github.com/ElephantRock/CSD-Foundry/specs/v0.4/release_policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choice_path_schema_version": {
      "const": "csd-choice-path/0.4"
    },
    "maximum_trajectory_steps": {
      "minimum": 1,
      "type": "integer"
    },
    "performance_policy_status": {
      "enum": [
        "unfrozen",
        "frozen"
      ]
    },
    "pilot_trajectory_count": {
      "minimum": 1,
      "type": "integer"
    },
    "release": {
      "const": "v0.4"
    },
    "release_blocked_until_policies_frozen": {
      "type": "boolean"
    },
    "rng_algorithm": {
      "const": "csd-choice-hmac-sha256-rejection"
    },
    "rng_version": {
      "const": "1"
    },
    "root_seed": {
      "allOf": [
        {
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "not": {
            "pattern": "^([0-9a-f]{2})\\1{31}$"
          }
        }
      ],
      "type": "string"
    },
    "root_seed_provenance": {
      "const": "uniform-random-256"
    },
    "schema_version": {
      "const": "0.4.0"
    },
    "split_hash_salt": {
      "minLength": 1,
      "type": "string"
    },
    "stochastic_risk_policy_status": {
      "enum": [
        "unfrozen",
        "frozen"
      ]
    },
    "target_trajectory_count": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "release",
    "schema_version",
    "target_trajectory_count",
    "pilot_trajectory_count",
    "maximum_trajectory_steps",
    "root_seed",
    "root_seed_provenance",
    "rng_algorithm",
    "rng_version",
    "choice_path_schema_version",
    "split_hash_salt",
    "performance_policy_status",
    "stochastic_risk_policy_status",
    "release_blocked_until_policies_frozen"
  ],
  "title": "CSD Foundry v0.4 Release Policy",
  "type": "object"
}
