{
  "$id": "https://github.com/ElephantRock/CSD-Foundry/specs/v0.4/coverage_targets.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "release": {
      "const": "v0.4"
    },
    "schema_version": {
      "const": "0.4.0"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "completeness": {
            "additionalProperties": false,
            "properties": {
              "alternative_witness_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bounded_projection_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence_kind": {
                "enum": [
                  "fully_bounded",
                  "projected_bounded",
                  "alternative_assurance"
                ]
              },
              "justification": {
                "minLength": 1,
                "type": "string"
              },
              "omitted_dimensions": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "evidence_kind",
              "bounded_projection_id",
              "omitted_dimensions",
              "justification",
              "alternative_witness_id"
            ],
            "type": "object"
          },
          "disposition": {
            "enum": [
              "required",
              "exploratory",
              "machine_proven_infeasible",
              "unresolved"
            ]
          },
          "event_pattern": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "holdout_tags": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "infeasibility_witness": {
            "type": [
              "object",
              "null"
            ]
          },
          "minimum_count": {
            "minimum": 0,
            "type": "integer"
          },
          "profile_pattern": {
            "minLength": 1,
            "type": "string"
          },
          "rarity_weight": {
            "minimum": 1,
            "type": "integer"
          },
          "request_pattern": {
            "minLength": 1,
            "type": "string"
          },
          "required_consequences": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "required_invariants": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "search_budget": {
            "additionalProperties": false,
            "properties": {
              "maximum_construction_attempts_per_plan": {
                "minimum": 0,
                "type": "integer"
              },
              "maximum_elapsed_milliseconds": {
                "minimum": 0,
                "type": "integer"
              },
              "maximum_oracle_attempts": {
                "minimum": 0,
                "type": "integer"
              },
              "maximum_plan_attempts": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "maximum_plan_attempts",
              "maximum_construction_attempts_per_plan",
              "maximum_oracle_attempts",
              "maximum_elapsed_milliseconds"
            ],
            "type": "object"
          },
          "target_id": {
            "minLength": 1,
            "type": "string"
          },
          "temporal_pattern": {
            "minLength": 1,
            "type": "string"
          },
          "topology_pattern": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "disposition",
          "topology_pattern",
          "event_pattern",
          "temporal_pattern",
          "request_pattern",
          "profile_pattern",
          "required_invariants",
          "required_consequences",
          "minimum_count",
          "rarity_weight",
          "holdout_tags",
          "search_budget",
          "completeness",
          "infeasibility_witness"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "release",
    "schema_version",
    "targets"
  ],
  "title": "CSD Foundry v0.4 Coverage Target Catalog",
  "type": "object"
}
